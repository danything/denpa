<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        チューナーエージェント。

        **Native AOT。** 別の PC へ置くときに「まず何かを入れてください」が
        要らないことが条件なので、ここは外せない。
        出来上がるのは 13MB ほどの実行ファイル 1 個。

        依存を 1 つも足していない。JSON は System.Text.Json.Nodes で木を直に組み、読む。
        AOT ではリフレクションを使う方式が素直に動かない (Json.cs)。
    -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PublishAot>true</PublishAot>
        <!-- ioctl や poll にポインタを直に渡す (Tuning.cs / UsbFs.cs)。LibraryImport が生成するコードも要る -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>denpa-agent</AssemblyName>
        <RootNamespace>Denpa.Agent</RootNamespace>
        <!--
            バージョン。リリースでは `-p:InformationalVersion=<タグ>` で上書きして組む (macOS と Windows。
            Linux のイメージは組み直さないので DENPA_VERSION で知る。About.cs)。`+コミット` は足さない
        -->
        <InformationalVersion>dev</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <!--
            IT930x のファームウェア (ITE Tech. の許諾を得て無改変で同梱する。firmware/README.md)。
            実行ファイルに埋め込み、1 個のまま配れるようにする。機材を開くたびに流し込む (It930xFirmware.cs)
        -->
        <EmbeddedResource Include="firmware/it930x-firmware.bin" LogicalName="it930x-firmware.bin" />
        <!--
            Siano RIO 系の機材 (PX-S1UD など) の ISDB-T のファームウェア (Siano の許諾で無改変なら再配布できる。firmware/README.md)。
            実行ファイルに埋め込み、機材を開くたびにそのまま送る (SianoFirmware.cs)。許諾の文面 (firmware/LICENCE.siano) は配布物に添える
        -->
        <EmbeddedResource Include="firmware/isdbt_rio.inp" LogicalName="isdbt_rio.inp" />
    </ItemGroup>

    <!--
        Android 向け (`-r linux-bionic-arm64`・`linux-bionic-x64`)。組み方は docs/development.md「Android 向けのエージェント」。

        - .NET の SDK は ASP.NET Core の実行時パックを bionic 向けに出していない (`RuntimePackExcludedRuntimeIdentifiers="android;linux-bionic"`)。
          除外を外すと、RID の木 (linux-bionic-arm64 → linux-arm64) で linux の ASP.NET Core のパックが選ばれる。
          ILC は IL から組むので、パックの中の R2R のコードは使わない。SDK が支えていない使い方なので、SDK を上げたら Android の CI を見る
        - Android には OpenSSL が無い (端末の libssl は BoringSSL で、名前も中身も違う)。NDK で組んだ OpenSSL の静的ライブラリ
          (`OPENSSL_ROOT_DIR` が指す置き場) を実行ファイルに入れる。暗号の部品は組むときにソースから組まれ、cmake がそこを読む
        - C の部品とリンクは NDK の clang で組む (NDK の `toolchains/llvm/prebuilt/linux-x86_64/bin` を PATH の先頭に置く)
    -->
    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic-'))">
        <DisableUnsupportedError>true</DisableUnsupportedError>
        <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
        <StaticOpenSslLinking>true</StaticOpenSslLinking>
        <CppCompilerAndLinker Condition="'$(RuntimeIdentifier)' == 'linux-bionic-arm64'">aarch64-linux-android24-clang</CppCompilerAndLinker>
        <CppCompilerAndLinker Condition="'$(RuntimeIdentifier)' == 'linux-bionic-x64'">x86_64-linux-android24-clang</CppCompilerAndLinker>
    </PropertyGroup>
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic-'))">
        <KnownFrameworkReference Update="Microsoft.AspNetCore.App" RuntimePackExcludedRuntimeIdentifiers="" />
        <LinkerArg Include="-L$(OPENSSL_ROOT_DIR)/lib" />
        <!-- 16 KB ページの端末でも読み込めるように (ILC の targets は共有ライブラリにしか付けない) -->
        <LinkerArg Include="-Wl,-z,max-page-size=16384" />
    </ItemGroup>
    <Target Name="DenpaCheckAndroidOpenSsl" BeforeTargets="Build" Condition="$(RuntimeIdentifier.StartsWith('linux-bionic-'))">
        <Error Condition="'$(OPENSSL_ROOT_DIR)' == '' or !Exists('$(OPENSSL_ROOT_DIR)/lib/libssl.a')" Text="OPENSSL_ROOT_DIR に、NDK で組んだ OpenSSL の置き場 (lib/libssl.a と include/) を渡してください" />
    </Target>

</Project>
