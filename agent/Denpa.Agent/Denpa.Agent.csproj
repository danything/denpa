<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        チューナーエージェント。

        **Native AOT。** 別のPCへ置くときに「まず何かを入れてください」が
        要らないことが条件なので、ここは外せない。
        出来上がるのは 13MB ほどの実行ファイル1個。

        依存を1つも足していない。JSON は System.Text.Json.Nodes で木を直に組み、読む —
        AOT では反射を使う道が素直に動かない (Json.cs)。
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PublishAot>true</PublishAot>
        <!-- ioctl や poll にポインタを直に渡す (Tuning.cs / UsbFs.cs)。LibraryImport が生成するコードも要る -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>denpa-agent</AssemblyName>
        <RootNamespace>Denpa.Agent</RootNamespace>
    </PropertyGroup>

</Project>
