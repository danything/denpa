<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        チューナーエージェント。

        **Native AOT。** 別の PC へ置くときに「まず何かを入れてください」が
        要らないことが条件なので、ここは外せない。
        出来上がるのは 13MB ほどの実行ファイル 1 個。

        依存を 1 つも足していない。JSON は System.Text.Json.Nodes で木を直に組み、読む。
        AOT ではリフレクションを使う方式が素直に動かない (Json.cs)。
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PublishAot>true</PublishAot>
        <!-- ioctl や poll にポインタを直に渡す (Tuning.cs / UsbFs.cs)。LibraryImport が生成するコードも要る -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>denpa-agent</AssemblyName>
        <RootNamespace>Denpa.Agent</RootNamespace>
        <!--
            バージョン。リリースでは `-p:InformationalVersion=<タグ>` で上書きして組む (macOS と Windows。
            Linux のイメージは組み直さないので DENPA_VERSION で知る。About.cs)。`+コミット` は足さない
        -->
        <InformationalVersion>dev</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <!--
            IT930x のファームウェア (ITE Tech. の許諾を得て無改変で同梱する。firmware/README.md)。
            実行ファイルに埋め込み、1 個のまま配れるようにする。px4d に渡すときに書き出す (Px4Firmware.cs)
        -->
        <EmbeddedResource Include="firmware/it930x-firmware.bin" LogicalName="it930x-firmware.bin" />
        <!--
            PIX-DT295 の常駐方式で機材に入れる mAgicVISION のファームウェア (作者が再配布を認めている。firmware/README.md)。
            その移植元のコードの MIT の表示も埋め込み、実行ファイルといっしょに配る (Dt295ResidentImage.cs)
        -->
        <EmbeddedResource Include="firmware/magicvision-firmware.bin" LogicalName="magicvision-firmware.bin" />
        <EmbeddedResource Include="licenses/mAgicVISION.txt" LogicalName="mAgicVISION-LICENSE.txt" />
    </ItemGroup>

</Project>
