<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <!-- 本体は Web SDK なので、テストからは中身のクラスだけ借りる -->
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="*.cs" />
        <Compile Include="../Denpa.Agent/Json.cs" />
        <Compile Include="../Denpa.Agent/Config.cs" />
        <Compile Include="../Denpa.Agent/TunerPool.cs" />
        <Compile Include="../Denpa.Agent/Interop.cs" />
        <Compile Include="../Denpa.Agent/DeviceProbe.cs" />
        <Compile Include="../Denpa.Agent/ChannelTable.cs" />
        <Compile Include="../Denpa.Agent/Tuning.cs" />
        <Compile Include="../Denpa.Agent/AribB25.cs" />
        <Compile Include="../Denpa.Agent/CardShare.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- MTP (global.json の test.runner) で回すので、旧 VSTest 系
             (Microsoft.NET.Test.Sdk / xunit.runner.visualstudio) は持たない。
             xunit.v3 だけで MTP のテストアプリとして完結する -->
        <PackageReference Include="xunit.v3" Version="4.0.0" />
    </ItemGroup>

</Project>
