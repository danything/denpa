 namespace aribcaption {
 
+namespace {
+
+// Grey-scale (0-255) copy of a DRCS pattern
+struct GreyPattern {
+    int width = 0;
+    int height = 0;
+    std::vector<uint8_t> pixels;
+
+    [[nodiscard]] uint8_t At(int x, int y) const {
+        x = std::clamp(x, 0, width - 1);
+        y = std::clamp(y, 0, height - 1);
+        return pixels[y * width + x];
+    }
+};
+
+GreyPattern DecodePattern(const DRCS& drcs) {
+    GreyPattern pattern;
+    pattern.width = drcs.width;
+    pattern.height = drcs.height;
+    pattern.pixels.resize(static_cast<size_t>(drcs.width) * drcs.height);
+
+    for (int i = 0; i < drcs.width * drcs.height; i++) {
+        intptr_t index = static_cast<intptr_t>(i) * drcs.depth_bits / 8;
+        intptr_t bit_offset = static_cast<intptr_t>(i) * drcs.depth_bits % 8;
+        uint8_t byte = drcs.pixels[index];
+        uint8_t value = (byte >> (8 - (bit_offset + drcs.depth_bits))) & (drcs.depth - 1);
+        pattern.pixels[i] = alphablend::Clamp255((uint32_t)255 * value / (drcs.depth - 1));
+    }
+
+    return pattern;
+}
+
+// Many broadcasters send 2x pixel-doubled patterns (e.g. 18x18 glyphs as 36x36).
+// Drop duplicated columns / rows so that the smoothing below sees the real resolution. Lossless.
+void CollapseDoubled(GreyPattern& pattern) {
+    while (true) {
+        bool cols = pattern.width % 2 == 0;
+        bool rows = pattern.height % 2 == 0;
+        for (int y = 0; y < pattern.height && (cols || rows); y++) {
+            for (int x = 0; x < pattern.width; x++) {
+                if (cols && x % 2 == 0 && pattern.At(x, y) != pattern.At(x + 1, y)) {
+                    cols = false;
+                }
+                if (rows && y % 2 == 0 && pattern.At(x, y) != pattern.At(x, y + 1)) {
+                    rows = false;
+                }
+            }
+        }
+        if (!cols && !rows) {
+            return;
+        }
+
+        GreyPattern collapsed;
+        collapsed.width = cols ? pattern.width / 2 : pattern.width;
+        collapsed.height = rows ? pattern.height / 2 : pattern.height;
+        collapsed.pixels.resize(static_cast<size_t>(collapsed.width) * collapsed.height);
+        for (int y = 0; y < collapsed.height; y++) {
+            for (int x = 0; x < collapsed.width; x++) {
+                collapsed.pixels[y * collapsed.width + x] = pattern.At(cols ? x * 2 : x, rows ? y * 2 : y);
+            }
+        }
+        pattern = std::move(collapsed);
+    }
+}
+
+// Scale2x (EPX): doubles the pattern, rounding off staircase diagonals
+GreyPattern Scale2x(const GreyPattern& src) {
+    GreyPattern dst;
+    dst.width = src.width * 2;
+    dst.height = src.height * 2;
+    dst.pixels.resize(static_cast<size_t>(dst.width) * dst.height);
+
+    for (int y = 0; y < src.height; y++) {
+        for (int x = 0; x < src.width; x++) {
+            uint8_t p = src.At(x, y);
+            uint8_t a = y > 0 ? src.At(x, y - 1) : p;
+            uint8_t b = x < src.width - 1 ? src.At(x + 1, y) : p;
+            uint8_t c = x > 0 ? src.At(x - 1, y) : p;
+            uint8_t d = y < src.height - 1 ? src.At(x, y + 1) : p;
+
+            uint8_t* top = &dst.pixels[(y * 2) * dst.width + x * 2];
+            uint8_t* bottom = top + dst.width;
+            top[0] = (c == a && c != d && a != b) ? a : p;
+            top[1] = (a == b && a != c && b != d) ? b : p;
+            bottom[0] = (d == c && d != b && c != a) ? c : p;
+            bottom[1] = (b == d && b != a && d != c) ? d : p;
+        }
+    }
+
+    return dst;
+}
+
+// Bilinear sample at the center of target pixel (x, y)
+uint8_t SampleBilinear(const GreyPattern& pattern, int x, int y, int target_width, int target_height) {
+    float sx = (static_cast<float>(x) + 0.5f) * pattern.width / target_width - 0.5f;
+    float sy = (static_cast<float>(y) + 0.5f) * pattern.height / target_height - 0.5f;
+    sx = std::clamp(sx, 0.0f, static_cast<float>(pattern.width - 1));
+    sy = std::clamp(sy, 0.0f, static_cast<float>(pattern.height - 1));
+
+    int x0 = static_cast<int>(sx);
+    int y0 = static_cast<int>(sy);
+    float fx = sx - static_cast<float>(x0);
+    float fy = sy - static_cast<float>(y0);
+
+    float top = pattern.At(x0, y0) * (1.0f - fx) + pattern.At(x0 + 1, y0) * fx;
+    float bottom = pattern.At(x0, y0 + 1) * (1.0f - fx) + pattern.At(x0 + 1, y0 + 1) * fx;
+    return static_cast<uint8_t>(std::lround(top * (1.0f - fy) + bottom * fy));
+}
