+// Checks that DRCS glyphs are smoothed when upscaled, using synthetic patterns.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include "aribcaption/caption.hpp"
+#include "renderer/bitmap.hpp"
+#include "renderer/drcs_renderer.hpp"
+
+using namespace aribcaption;
+
+#define CHECK(cond)                                                     \
+    do {                                                                \
+        if (!(cond)) {                                                  \
+            fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #cond); \
+            exit(1);                                                    \
+        }                                                               \
+    } while (0)
+
+// 1-bit DRCS from an 18x18 picture, pixel-doubled to 36x36 like broadcasters do
+static DRCS MakeDoubled18(bool (*on)(int x, int y)) {
+    DRCS drcs;
+    drcs.width = 36;
+    drcs.height = 36;
+    drcs.depth = 2;
+    drcs.depth_bits = 1;
+    drcs.pixels.assign(36 * 36 / 8, 0);
+    for (int y = 0; y < 36; y++) {
+        for (int x = 0; x < 36; x++) {
+            if (on(x / 2, y / 2)) {
+                int i = y * 36 + x;
+                drcs.pixels[i / 8] |= static_cast<uint8_t>(0x80 >> (i % 8));
+            }
+        }
+    }
+    return drcs;
+}
+
+static Bitmap Render(const DRCS& drcs, int size) {
+    Bitmap bitmap(size, size, PixelFormat::kRGBA8888);
+    DRCSRenderer renderer;
+    CHECK(renderer.DrawDRCS(drcs, kCharStyleDefault, ColorRGBA(255, 255, 255, 255), ColorRGBA(0, 0, 0, 255),
+                            0, size, size, bitmap, 0, 0));
+    return bitmap;
+}
+
+int main() {
+    // A diagonal line: nearest neighbour would leave 4px stairs at 72px
+    Bitmap line = Render(MakeDoubled18([](int x, int y) { return x == y; }), 72);
+    bool has_partial = false;
+    int prev_left = -1;
+    for (int y = 0; y < 72; y++) {
+        int left = -1;
+        for (int x = 0; x < 72; x++) {
+            uint8_t a = line.GetPixelAt(x, y)->a;
+            if (a > 0 && a < 250) {
+                has_partial = true;
+            }
+            if (left < 0 && a >= 128) {
+                left = x;
+            }
+        }
+        CHECK(left >= 0);
+        if (prev_left >= 0) {
+            CHECK(left - prev_left >= 0 && left - prev_left <= 2);
+        }
+        prev_left = left;
+    }
+    CHECK(has_partial);
+    CHECK(line.GetPixelAt(0, 71)->a == 0);
+    CHECK(line.GetPixelAt(71, 0)->a == 0);
+
+    // A filled square stays fully opaque, edges included
+    Bitmap block = Render(MakeDoubled18([](int, int) { return true; }), 72);
+    CHECK(block.GetPixelAt(0, 0)->a >= 250);
+    CHECK(block.GetPixelAt(36, 36)->a >= 250);
+    CHECK(block.GetPixelAt(71, 71)->a >= 250);
+
+    // Same size as the pattern: no blur on an axis-aligned box
+    Bitmap box = Render(MakeDoubled18([](int x, int y) { return x >= 4 && x < 14 && y >= 4 && y < 14; }), 36);
+    CHECK(box.GetPixelAt(18, 18)->a >= 250);
+    CHECK(box.GetPixelAt(2, 2)->a == 0);
+
+    printf("ok\n");
+    return 0;
+}
