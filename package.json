{
    "name": "denpa",
    "license": "AGPL-3.0-or-later",
    "devDependencies": {
        "@anyblades/blades": "3.0.0",
        "@biomejs/biome": "^2.5.15",
        "@playwright/test": "^1.63.0",
        "@sveltejs/adapter-node": "^6.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/bun": "^1.4.2",
        "bits-ui": "2.19.5",
        "drizzle-kit": "0.31.11",
        "drizzle-orm": "^0.45.3",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.0",
        "vite": "^8.3.2",
        "web-bml": "1.0.1"
    },
    "private": true,
    "scripts": {
        "dev": "bunx --bun vite dev",
        "build": "bunx --bun vite build",
        "start": "bun ./server.js",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
        "db:generate": "drizzle-kit generate",
        "test": "bun run lint && bun run check && bun run test:unit && playwright test",
        "test:unit": "bun test src",
        "test:conformance": "dotnet publish agent/Denpa.Agent/Denpa.Agent.csproj -c Release -r linux-x64 -o agent/publish && AGENT_CMD=\"$PWD/agent/publish/denpa-agent\" bun test agent/conformance.test.ts",
        "test:e2e": "playwright test",
        "lint": "biome check .",
        "format": "biome check --write ."
    },
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
