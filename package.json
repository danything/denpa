{
    "name": "denpa",
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@playwright/test": "^1.56.1",
        "@sveltejs/adapter-node": "^5.4.0",
        "@sveltejs/kit": "^2.49.2",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/vite": "^4.1.16",
        "@types/bun": "^1.3.5",
        "daisyui": "^5.5.5",
        "svelte": "^5.43.10",
        "svelte-check": "^4.3.7",
        "tailwindcss": "^4.1.16",
        "typescript": "^5.9.3",
        "vite": "^8.0.0"
    },
    "private": true,
    "scripts": {
        "dev": "bunx --bun vite dev",
        "build": "bunx --bun vite build",
        "start": "bun ./server.js",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "bun run lint && bun run check && bun run test:unit && playwright test",
        "test:unit": "bun test src",
        "test:conformance": "dotnet publish agent/Denpa.Agent/Denpa.Agent.csproj -c Release -r linux-x64 -o agent/publish && AGENT_CMD=\"$PWD/agent/publish/denpa-agent\" bun test agent/conformance.test.ts",
        "test:e2e": "playwright test",
        "lint": "biome check .",
        "format": "biome check --write ."
    },
    "type": "module",
    "dependencies": {
        "buffer": "^6.0.3",
        "crc-32": "^1.2.2",
        "css": "https://github.com/otya128/reworkcss-css/releases/download/v3.0.1/css-3.0.1.tgz",
        "fast-xml-parser": "^5.10.1"
    }
}
