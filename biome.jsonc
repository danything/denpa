{
    "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
    "files": {
        "includes": [
            "**",
            "!build",
            "!.svelte-kit",
            "!test-results",
            "!playwright-report",
            "!static",
            "!deploy",
            // Helm のテンプレートは Go のテンプレートで、YAML として読めない
            "!charts/*/templates",
            // drizzle-kit が出すマイグレーション (SQL と snapshot の JSON)。手では触らない
            "!drizzle",
            "!renovate.json",
            "!agent/Denpa.Agent",
            "!agent/Denpa.Agent.Tests",
            "!agent/publish",
            // 文書サイト。ビルドの成果物と、scripts/import-docs.ts が docs から書き出すもの
            // アイコンは static/ の写し (static/ と同じく外す)
            "!site/public",
            "!site/src/assets/logo.svg",
            "!site/dist",
            "!site/.astro",
            "!site/src/content/docs",
            "!site/src/assets/docs",
            "!site/src/generated",
            "!site/test-results",
            "!site/playwright-report"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 110
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "noNonNullAssertion": "off"
            },
            "complexity": {
                // tsconfig の noPropertyAccessFromIndexSignature と逆向き。
                // `process.env['X']` のように、型が index signature のものは [] で読む
                "useLiteralKeys": "off"
            },
            "a11y": {
                // 字幕は放送が画像として描くものを送ってくる。canvas に重ねるので <track> に渡せるものが無い
                "useMediaCaption": "off",
                // 行そのものを押せるようにしていて、中にも押せるものが入っている。<button> は入れ子にできない
                "useSemanticElements": "off"
            },
            "correctness": {
                // 自前の describe() (値や状態を言葉にする関数) を Playwright の describe と取り違える
                "usePlaywrightValidDescribeCallback": "off",
                // 行ごとの数がそろっていても、行を分けて書いた grid-template-areas を「数が合わない」と言う (2.6.2。Tuners.svelte)
                "noInvalidGridAreas": "off"
            },
            "performance": {
                // 試験と計測は「画面に見えている文字」を読む (改行・隠れた要素の扱いが textContent と違う)
                "useDomNodeTextContent": "off"
            },
            "suspicious": {
                // 覚えた局はサーバが SSR で読む。Cookie Store API では渡らない
                "noDocumentCookie": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    // YAML は 2 字下げ (compose・Helm・GitHub Actions の慣わし)
    "yaml": {
        "formatter": {
            "indentWidth": 2,
            "quoteStyle": "single"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "html": {
        "experimentalFullSupportEnabled": true
    }
}
