{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "files": {
        "includes": [
            "**",
            "!build",
            "!.svelte-kit",
            "!test-results",
            "!playwright-report",
            "!static",
            "!k3s",
            "!windows",
            "!docs",
            "!.github",
            "!renovate.json",
            "!agent/Denpa.Agent",
            "!agent/Denpa.Agent.Tests",
            "!agent/publish",
            "!src/lib/vendor"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 110
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "noNonNullAssertion": "off"
            },
            "a11y": {
                // 字幕は放送が絵で送ってくる。canvas に重ねるので <track> に渡せるものが無い
                "useMediaCaption": "off",
                // 行そのものを押せるようにしていて、中にも押せるものが入っている。<button> は入れ子にできない
                "useSemanticElements": "off"
            },
            "suspicious": {
                // 覚えた局はサーバが SSR で読む。Cookie Store API では渡らない
                "noDocumentCookie": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "html": {
        "experimentalFullSupportEnabled": true
    }
}
