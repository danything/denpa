asicen-userland/
# bun の公式の Android 版 (CI が .github/bun-android.sh で置く。app/build.gradle.kts の DENPA_BUN)
bun/
# ffmpeg・ffprobe と libav* (CI が .github/ffmpeg-android.sh で組んで置く。app/build.gradle.kts の DENPA_FFMPEG)
ffmpeg/
