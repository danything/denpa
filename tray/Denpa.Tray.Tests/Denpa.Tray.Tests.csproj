<Project Sdk="Microsoft.NET.Sdk">

    <!--
        通知領域のアプリのうち、Win32 に触らないところ (Health.cs) のテスト。Linux でも流れる。
        TUnit なので、エージェントのテストと同じく自分で実行できるアプリにする (agent/Denpa.Agent.Tests の csproj)
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="*.cs" />
        <Compile Include="../Denpa.Tray/Health.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.81.16" />
    </ItemGroup>

</Project>
