---
/*
 * Starlight の既定のフッタ (編集・最終更新・前後のページ) の下に、README の「使ってよい範囲」の要約を出す。
 * 文は scripts/import-docs.ts が README から取ってくる (src/generated/usage.json)。ここには書かない
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import { base } from '../data/pages.ts';
import usage from '../generated/usage.json';

const escapeHtml = (s: string) =>
    s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');
// 要約は README の段落そのまま。太字 (**…**) だけ活かす
const summary = usage ? escapeHtml(usage.summary).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>') : '';
// トップには節そのものがあるので、要約は出さない
const isTop = Astro.url.pathname === base;
---

<Default />
{
    usage && !isTop && (
        <aside class="usage" aria-label="使ってよい範囲">
            <p>
                <Fragment set:html={summary} />
            </p>
            {/* リンクは 1 つずつ折り返さずに並べる (途中で切れて次の行に落ちないように) */}
            <ul class="usage-links">
                <li>
                    <a href={usage.anchor}>使ってよい範囲</a>
                </li>
                {usage.discussion && (
                    <li>
                        <a href={usage.discussion.url}>{usage.discussion.label}</a>
                    </li>
                )}
            </ul>
        </aside>
    )
}

<style>
    .usage {
        margin-top: 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--sl-color-hairline);
        font-size: var(--sl-text-xs);
        line-height: 1.7;
        color: var(--sl-color-gray-3);
    }
    .usage p {
        margin: 0;
    }
    .usage-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        margin: 0.5rem 0 0;
        padding: 0;
        list-style: none;
    }
    .usage-links li {
        white-space: nowrap;
    }
    .usage a {
        color: var(--sl-color-text-accent);
    }
</style>
