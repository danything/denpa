---
/*
 * トップ。文は README から取り (scripts/import-docs.ts が節ごとに src/generated/readme/*.md へ切り出す)、
 * ここで新しく書くのは見出しの一言だけ。どの節を出すか・入口のカードは src/data/pages.ts
 */

import { getImage } from 'astro:assets';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { base, heroImage, repoUrl, tagline, videoImageNote, videoImages } from '../data/pages.ts';
import { softwareApplication } from '../data/structured-data.ts';
import top from '../generated/top.json';

const parts = import.meta.glob<{ Content: AstroComponentFactory }>('../generated/readme/*.md', { eager: true });
const part = (key: string) => parts[`../generated/readme/${key}.md`]?.Content;
const Intro = part('intro');
const install = top.sections.find((s) => s.key === 'install');
// 見出しの横の画面。Starlight の hero の画像は 400×400 の枠に収める作りで横長の画面が小さくなるので、
// 最適化だけ Astro に任せ、<img> は自前で書く (image.html)
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/docs/*.{webp,png,jpg}', { eager: true });
const heroSource = images[`../assets/docs/${heroImage.file}`]?.default;
const heroImg = heroSource && (await getImage({ src: heroSource, width: Math.min(heroSource.width, 1280) }));
const escapeAttr = (s: string) => s.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;');
const heroHtml =
    heroImg &&
    `<figure class="hero-shot"><img src="${heroImg.src}" alt="${escapeAttr(heroImage.alt)}" width="${heroImg.attributes['width']}" height="${heroImg.attributes['height']}" decoding="async" />${
        videoImages.includes(heroImage.file) ? `<figcaption>${videoImageNote}</figcaption>` : ''
    }</figure>`;

const hero = {
    title: 'denpa',

    tagline: `${tagline}。<br />チューナーを挿して、スキャンを押すだけ。`,
    ...(heroHtml ? { image: { html: heroHtml } } : {}),
    actions: [
        {
            text: '入れる',
            link: install ? `#${install.id}` : `${base}install/`,
            icon: 'right-arrow',
        },
        { text: '画面を見る', link: `${base}screens/`, variant: 'minimal' as const },
        {
            text: 'GitHub',
            link: repoUrl,
            icon: 'external',
            variant: 'minimal' as const,
        },
    ],
};
const head = [
    { tag: 'meta' as const, attrs: { property: 'og:type', content: 'website' } },
    await softwareApplication(top.description),
];
---

<StarlightPage
    frontmatter={{ title: tagline, description: top.description, template: 'splash', hero, head }}
>
    <div class="top">
        {Intro && <section class="top-intro"><Intro /></section>}
        {
            top.sections.map((s) => {
                const Content = part(s.key);
                return (
                    Content && (
                        <section class={`top-section top-${s.key}`} aria-labelledby={s.id}>
                            <h2 id={s.id}>{s.heading}</h2>
                            <Content />
                        </section>
                    )
                );
            })
        }
        {
            top.entrances.length > 0 && (
                <section class="top-section top-entrances" aria-labelledby="もっと詳しく">
                    <h2 id="もっと詳しく">もっと詳しく</h2>
                    <ul class="entrances not-content">
                        {top.entrances.map((e) => (
                            <li>
                                <h3>
                                    <a href={e.href}>{e.label}</a>
                                </h3>
                                <p>{e.description}</p>
                                {e.more.length > 0 && (
                                    <ul>
                                        {e.more.map((m) => (
                                            <li>
                                                <a href={m.href}>{m.title}</a>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }
    </div>
</StarlightPage>

<style is:global>
    /*
     * 見出しの段 (Starlight の hero) を詰める。既定は右に正方形の画像を置く前提で、上下の余白も大きい。
     * ここでは横長の画面を右に大きめに置き、上下と本文までの間を狭くする
     */
    .hero {
        max-width: 56rem;
        margin-inline: auto;
        padding-block: 1rem 0;
        gap: 1.5rem;
    }
    .hero > .hero-html {
        width: 100%;
    }
    .hero-shot {
        margin: 0;
    }
    .hero-shot img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: var(--dp-radius);
        box-shadow: 0 0.5rem 2rem rgb(0 0 0 / 0.18);
    }
    .hero-shot figcaption {
        margin-top: 0.25rem;
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
    }
    @media (min-width: 50rem) {
        .hero {
            grid-template-columns: 11fr 13fr;
            gap: 2.5rem;
            padding-block: 2rem 0.5rem;
        }
        .hero .tagline {
            font-size: var(--sl-text-lg);
        }
        .hero > .hero-html {
            width: 100%;
        }
    }
</style>

<style>
    .top {
        max-width: 56rem;
        margin-inline: auto;
    }
    .top-intro {
        font-size: var(--sl-text-lg);
    }
    .top-intro :global(img) {
        display: block;
        margin-inline: auto;
        box-shadow: 0 0.5rem 2rem rgb(0 0 0 / 0.15);
    }
    .top-intro :global(.shots) {
        font-size: var(--sl-text-base);
    }
    .top-section {
        margin-top: 2.75rem;
    }
    .top-section > h2 {
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--sl-color-accent);
    }

    /* できること: 1 項目ずつ面にして並べる */
    .top-features :global(ul) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        gap: 0.75rem;
        padding: 0;
        list-style: none;
    }
    .top-features :global(li) {
        margin: 0;
        padding: 0.9rem 1rem;
        border: 1px solid var(--sl-color-hairline);
        border-radius: var(--dp-radius);
        background: var(--sl-color-bg-nav);
    }

    /* 使ってよい範囲: 読み飛ばされないよう、主の色の枠で囲む */
    .top-usage {
        padding: 0.25rem 1.5rem 1.25rem;
        border: 1px solid var(--sl-color-hairline);
        border-left: 4px solid var(--sl-color-accent);
        border-radius: var(--dp-radius);
        background: var(--sl-color-bg-nav);
    }
    .top-usage > h2 {
        border-bottom: 0;
    }

    /* もっと詳しく: 入口のカード */
    .entrances {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        gap: 1rem;
        margin-top: 1.25rem;
        padding: 0;
        list-style: none;
    }
    .entrances > li {
        padding: 1rem 1.25rem;
        border: 1px solid var(--sl-color-hairline);
        border-radius: var(--dp-radius);
        background: var(--sl-color-bg-nav);
    }
    .entrances h3 {
        margin: 0;
        font-size: var(--sl-text-h4);
    }
    .entrances h3 a {
        color: var(--sl-color-text-accent);
    }
    .entrances p {
        margin: 0.5rem 0 0;
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-2);
    }
    .entrances ul {
        margin: 0.75rem 0 0;
        padding-left: 1.1rem;
        font-size: var(--sl-text-sm);
    }
    .entrances ul a {
        color: var(--sl-color-text-accent);
    }
</style>
